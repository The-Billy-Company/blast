{
  // These trees are fetched or generated. The Rust target may contain a full
  // semver-checks copy of this repository, so watching it doubles the project
  // for no editing value.
  "files.watcherExclude": {
    "**/.zig-cache/**": true,
    "**/zig-out/**": true,
    "**/zig-pkg/**": true,
    "**/bindings/rust/target/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.ruff_cache/**": true
  },
  "search.exclude": {
    "**/.zig-cache": true,
    "**/zig-out": true,
    "**/zig-pkg": true,
    "**/bindings/rust/target": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.ruff_cache": true
  },
  "search.followSymlinks": false,

  // Content guessing must not overrule the repository's .editorconfig.
  "editor.detectIndentation": false,
  "files.eol": "\n",
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {},

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": false
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": false,
    "editor.insertSpaces": false
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": false
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.formatOnSave": false
  },
  // ZLS is bit-for-bit `zig fmt` only when it resolves the Zig 0.16.0 pinned by
  // this repository. A stray Homebrew compiler can silently disagree with the
  // fmt CI job, so let mise provide the toolchain rather than hardcoding a path.
  "[zig]": {
    "editor.defaultFormatter": "ziglang.vscode-zig",
    "editor.formatOnSave": false
  }
}
