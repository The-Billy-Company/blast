{
  // These are the real contributor loop, not editor-only aliases. Every build
  // expects irregex, gist, and relate checked out as siblings beside blast; a
  // lone clone cannot configure the package graph.
  "version": "2.0.0",
  "presentation": {
    "reveal": "always",
    "panel": "dedicated",
    "clear": true
  },
  "tasks": [
    {
      "label": "zig: check",
      "type": "shell",
      "command": "zig build check",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "zig: test",
      "type": "shell",
      "command": "zig build test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "zig: test filter",
      "type": "shell",
      "command": "zig build test -Dtest-filter=${input:testFilter}",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "zig: check watch",
      "type": "shell",
      "command": "zig build check --watch",
      "isBackground": true,
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "testFilter",
      "type": "promptString",
      "description": "Substring matched against Zig test names"
    }
  ]
}
