.{
    .name = .blast,
    .version = "1.1.0", // x-release-please-version
    .fingerprint = 0x4e4fa58c86d8e88e,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Sibling-checkout path deps (dev). Releases pin url+hash via the
        // publish script — see the ecosystem split plan.
        .irregex = .{ .path = "../irregex" },
        .relate = .{ .path = "../relate" },
        // The shard-aware test runner (build-time only, no artifact, no ABI).
        // Pinned rather than path-dep'd, unlike the siblings above: those are
        // co-developed and land together, so a checkout beside this one is the
        // point, while the runner is a published package whose version this
        // repository should choose deliberately.
        .brigade = .{
            .url = "https://github.com/The-Billy-Company/brigade/archive/refs/tags/v0.1.0.tar.gz",
            .hash = "brigade-0.1.0-1n1fSXIlAQC4kvSlWxrMgJPZe61yl2IDWzes5LNPLvo4",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "NOTICE",
    },
}
